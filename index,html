<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Cave Quest</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 100%; height: 100%;
    background: #0a0008;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  canvas {
    display: block;
    touch-action: none;
  }
  /* Portrait-only lock */
  #landscape-block {
    display: none;
    position: fixed;
    inset: 0;
    background: #0a0008;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    font-family: 'Press Start 2P', monospace;
    color: #fff;
    text-align: center;
    padding: 40px;
    gap: 24px;
  }
  #landscape-block span { font-size: clamp(48px, 10vw, 80px); }
  #landscape-block p { font-size: clamp(8px, 2vw, 14px); line-height: 2; color: #aaaacc; }
  @media (orientation: landscape) {
    #landscape-block { display: flex; }
  }
  #ui {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    font-family: 'Press Start 2P', monospace;
  }
  #score-display {
    position: absolute;
    top: env(safe-area-inset-top, 8px);
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: clamp(10px, 2vw, 16px);
    text-shadow: 2px 2px 0 #000, -1px -1px 0 #000;
    pointer-events: none;
    white-space: nowrap;
  }
  #sound-btn {
    position: absolute;
    top: env(safe-area-inset-top, 8px);
    right: 12px;
    background: rgba(0,0,0,0.5);
    border: 2px solid #7c4dff;
    color: #fff;
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    padding: 6px 10px;
    cursor: pointer;
    pointer-events: all;
    border-radius: 4px;
    z-index: 100;
  }
</style>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
</head>
<body>
<div id="landscape-block">
  <span>📱</span>
  <p>CAVE QUEST<br>is a portrait game.<br><br>Please rotate<br>your device.</p>
</div>
<canvas id="c"></canvas>
<div id="ui">
  <div id="score-display"></div>
  <button id="sound-btn">SFX OFF</button>
</div>

<script>
// ============================================================
// CAVE QUEST — Single file arcade game
// ============================================================

var canvas = document.getElementById('c');
var ctx = canvas.getContext('2d');
var scoreDisplay = document.getElementById('score-display');
var soundBtn = document.getElementById('sound-btn');

// ---- Resize ----
function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', function() { resize(); if (state.screen === 'title') drawTitle(); });

// ---- Audio ----
var audioCtx = null;
var soundOn = false;

function initAudio() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}

function playTone(freq, type, duration, vol) {
  if (!soundOn || !audioCtx) return;
  try {
    var o = audioCtx.createOscillator();
    var g = audioCtx.createGain();
    o.connect(g); g.connect(audioCtx.destination);
    o.type = type || 'square';
    o.frequency.setValueAtTime(freq, audioCtx.currentTime);
    g.gain.setValueAtTime((vol || 0.15), audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
    o.start(); o.stop(audioCtx.currentTime + duration);
  } catch(e) {}
}

function playFlap() {
  // Soft sine-wave thud — low pitch, very quiet, distinct from square-wave BGM
  playTone(110, 'sine', 0.06, 0.06);
}
function playScore() { playTone(440, 'square', 0.05, 0.1); playTone(660, 'square', 0.05, 0.1); }
function playDeath() {
  playTone(200, 'sawtooth', 0.1, 0.2);
  setTimeout(function(){ playTone(150, 'sawtooth', 0.1, 0.2); }, 100);
  setTimeout(function(){ playTone(100, 'sawtooth', 0.2, 0.2); }, 200);
}

// Chiptune BGM — 96 notes, two voices, stays same speed throughout
var bgmPlaying = false;
var bgmInterval = null;
var bgmIdx = 0;
var bgmTempo = 130; // fixed, never changes

// Main melody — 96 notes (3 distinct phrases of 32 notes each)
var bgmMelody = [
  // Phrase A — playful cave adventure
  330,0,392,0, 440,392,330,0, 294,330,370,0, 330,0,294,0,
  392,0,440,0, 494,440,392,0, 330,294,330,0, 370,0,330,0,
  // Phrase B — darker mysterious feel
  262,0,294,0, 330,311,294,0, 262,0,247,0, 262,294,330,0,
  311,0,330,0, 294,262,247,0, 220,0,247,0, 262,0,0,0,
  // Phrase C — triumphant build
  392,0,440,0, 494,523,494,0, 440,0,392,0, 440,494,523,0,
  494,0,440,0, 392,330,294,0, 330,0,370,0, 392,0,0,0
];

// Bass line — 96 notes matching each phrase
var bgmBass = [
  // Phrase A bass
  196,0,196,0, 220,0,196,0, 175,0,196,0, 196,0,175,0,
  220,0,220,0, 247,0,220,0, 196,0,196,0, 220,0,196,0,
  // Phrase B bass
  131,0,147,0, 165,0,147,0, 131,0,123,0, 131,0,147,0,
  156,0,165,0, 147,0,131,0, 110,0,123,0, 131,0,0,0,
  // Phrase C bass
  196,0,220,0, 247,0,262,0, 220,0,196,0, 220,0,247,0,
  247,0,220,0, 196,0,175,0, 196,0,185,0, 196,0,0,0
];

// Durations in ms — mix of 100/140/180 for rhythmic variety
var bgmDurations = [
  100,60,100,60, 140,100,100,60, 100,100,140,60, 180,100,140,60,
  100,60,100,60, 140,100,100,60, 100,100,180,60, 140,100,160,80,
  100,60,100,60, 100,100,140,60, 100,60,140,60,  100,100,100,60,
  140,60,140,60, 100,100,140,60, 180,60,100,60,  200,100,160,80,
  100,60,100,60, 120,100,120,60, 100,60,100,60,  120,100,100,60,
  120,60,100,60, 100,100,100,60, 140,60,140,60,  200,100,180,80
];

function startBGM() {
  if(bgmPlaying) return;
  bgmPlaying = true;
  // Don't reset bgmIdx so music continues from where it was
  scheduleBGM();
}
function scheduleBGM() {
  if(!soundOn || !bgmPlaying) return;
  var i = bgmIdx % bgmMelody.length;
  var mel = bgmMelody[i];
  var bas = bgmBass[i];
  var dur = bgmDurations[i];
  if(mel > 0) playTone(mel, 'square', dur * 0.0008, 0.07);
  if(bas > 0) playTone(bas, 'triangle', dur * 0.0009, 0.045);
  bgmIdx++;
  bgmInterval = setTimeout(scheduleBGM, dur);
}
function stopBGM() {
  bgmPlaying = false;
  if(bgmInterval) clearTimeout(bgmInterval);
}
function setBGMTempo(t) { /* intentionally no-op — tempo is now fixed */ }

soundBtn.addEventListener('click', function() {
  initAudio();
  soundOn = !soundOn;
  soundBtn.textContent = soundOn ? 'SFX ON' : 'SFX OFF';
  if (soundOn && state.screen === 'game') startBGM();
  else stopBGM();
});

// ---- Characters ----
// unlockScore: score needed to unlock (0 = always unlocked)
var CHARACTERS = [
  { id:'dex',     name:'Dex',    type:'Dragon',   gender:'M', color:'#e05c2a', accent:'#ff9a00', wingColor:'#c04010', unlockScore:0   },
  { id:'winston', name:'Winston',type:'Wizard',   gender:'M', color:'#4a3580', accent:'#c8a0ff', wingColor:'#7c5cc0', unlockScore:25  },
  { id:'gusty',   name:'Gusty',  type:'Ghost',    gender:'M', color:'#d0e8ff', accent:'#ffffff', wingColor:'#a0c0e8', unlockScore:50  },
  { id:'bruno',   name:'Bruno',  type:'Bat',      gender:'M', color:'#2a1a3a', accent:'#8060a0', wingColor:'#1a0a28', unlockScore:75  },
  { id:'knox',    name:'Knox',   type:'Knight',   gender:'M', color:'#708090', accent:'#c0d0e0', wingColor:'#c0a030', unlockScore:100 },
  { id:'flora',   name:'Flora',  type:'Fairy',    gender:'F', color:'#ff80c0', accent:'#ffffff', wingColor:'#ffe0f0', unlockScore:150 },
  { id:'vera',    name:'Vera',   type:'Valkyrie', gender:'F', color:'#c0b040', accent:'#ffe080', wingColor:'#e0d060', unlockScore:200 },
  { id:'phoebe',  name:'Phoebe', type:'Phoenix',  gender:'F', color:'#ff4010', accent:'#ffcc00', wingColor:'#ff8000', unlockScore:250 },
  { id:'rook',    name:'Rook',   type:'Rogue',    gender:'F', color:'#202838', accent:'#60c080', wingColor:'#304050', unlockScore:325 },
  { id:'marco',   name:'Marco',  type:'Monk',     gender:'M', color:'#c08040', accent:'#ffe0a0', wingColor:'#a06030', unlockScore:500 },
  { id:'myra',    name:'Myra',   type:'Mermaid',  gender:'F', color:'#0088cc', accent:'#00ffee', wingColor:'#00ccaa', unlockScore:750 },
  { id:'maverick',name:'Maverick',type:'Minotaur',gender:'M', color:'#5a3020', accent:'#c08040', wingColor:'#8b4513', unlockScore:1000}
];

// ---- Unlock helpers ----
function getHighScore() {
  return parseInt(localStorage.getItem('cq_hs') || '0');
}
function isUnlocked(charIndex) {
  return getHighScore() >= CHARACTERS[charIndex].unlockScore;
}
function fullName(ch) {
  return ch.name + ' the ' + ch.type;
}
// Save unlocks whenever a new high score is set
function saveHighScore(score) {
  var prev = getHighScore();
  if(score > prev) {
    localStorage.setItem('cq_hs', score);
    // Check if any new character was just unlocked and flash notification
    for(var i=0; i<CHARACTERS.length; i++) {
      var needed = CHARACTERS[i].unlockScore;
      if(needed > 0 && score >= needed && prev < needed) {
        state.newUnlock = i;
      }
    }
  }
}

// ---- Pixel art drawing ----
function drawPixelChar(ctx, ch, x, y, size, frame) {
  var s = size / 16;
  ctx.save();
  ctx.translate(x, y);

  var t = ch.type;
  if (t === 'Dragon') drawDragon(ctx, ch, s, frame);
  else if (t === 'Wizard') drawWizard(ctx, ch, s, frame);
  else if (t === 'Ghost') drawGhost(ctx, ch, s, frame);
  else if (t === 'Bat') drawBat(ctx, ch, s, frame);
  else if (t === 'Knight') drawKnight(ctx, ch, s, frame);
  else if (t === 'Fairy') drawFairy(ctx, ch, s, frame);
  else if (t === 'Valkyrie') drawValkyrie(ctx, ch, s, frame);
  else if (t === 'Phoenix') drawPhoenix(ctx, ch, s, frame);
  else if (t === 'Rogue') drawRogue(ctx, ch, s, frame);
  else if (t === 'Monk') drawMonk(ctx, ch, s, frame);
  else if (t === 'Mermaid') drawMermaid(ctx, ch, s, frame);
  else if (t === 'Minotaur') drawMinotaur(ctx, ch, s, frame);

  ctx.restore();
}

function px(ctx, x, y, w, h, color, s) {
  ctx.fillStyle = color;
  ctx.fillRect(x*s, y*s, (w||1)*s, (h||1)*s);
}

function drawDragon(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Body
  px(ctx,2,5,8,6,ch.color,s);
  // Head
  px(ctx,8,3,5,5,ch.color,s);
  // Snout
  px(ctx,11,5,3,2,'#ff6020',s);
  // Eye
  px(ctx,10,4,1,1,'#ffff00',s);
  px(ctx,10,4,1,1,'#000',s);
  // Wing
  if(flap){ px(ctx,2,2,5,4,ch.wingColor,s); } else { px(ctx,2,5,5,4,ch.wingColor,s); }
  // Tail
  px(ctx,0,7,3,2,ch.color,s);
  px(ctx,0,9,2,1,ch.color,s);
  // Legs
  px(ctx,4,10,2,2,'#c04010',s);
  px(ctx,7,10,2,2,'#c04010',s);
}

function drawWizard(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Robe body
  px(ctx,4,6,8,7,ch.color,s);
  // Head
  px(ctx,5,3,6,5,ch.accent,s);
  // Hat
  px(ctx,4,0,8,2,ch.color,s);
  px(ctx,5,2,6,2,ch.color,s);
  px(ctx,6,4,4,1,ch.color,s);
  // Stars on hat
  px(ctx,5,1,1,1,'#ffff00',s);
  px(ctx,9,1,1,1,'#ffff00',s);
  // Eyes
  px(ctx,6,5,1,1,'#000',s);
  px(ctx,9,5,1,1,'#000',s);
  // Beard
  px(ctx,5,7,6,2,'#e0e0e0',s);
  // Staff (wing equivalent)
  if(flap){ px(ctx,1,2,2,10,'#8b6020',s); px(ctx,0,2,3,1,ch.accent,s); }
  else { px(ctx,1,4,2,10,'#8b6020',s); px(ctx,0,4,3,1,ch.accent,s); }
}

function drawGhost(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Body wavy bottom
  px(ctx,2,4,12,8,ch.color,s);
  // Bottom wiggles
  if(flap){
    px(ctx,2,11,2,2,ch.color,s);
    px(ctx,6,12,2,1,ch.color,s);
    px(ctx,10,11,2,2,ch.color,s);
  } else {
    px(ctx,2,12,2,1,ch.color,s);
    px(ctx,6,11,2,2,ch.color,s);
    px(ctx,10,12,2,1,ch.color,s);
  }
  // Eyes
  px(ctx,4,6,3,3,'#4080ff',s);
  px(ctx,9,6,3,3,'#4080ff',s);
  px(ctx,5,7,1,2,'#000',s);
  px(ctx,10,7,1,2,'#000',s);
  // Mouth
  px(ctx,6,10,4,1,'#a0c0e8',s);
  // Glow
  ctx.globalAlpha = 0.2;
  px(ctx,1,3,14,10,'#a0d0ff',s);
  ctx.globalAlpha = 1;
}

function drawBat(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Body
  px(ctx,5,6,6,5,ch.color,s);
  // Head
  px(ctx,5,3,6,4,ch.color,s);
  // Ears
  px(ctx,4,1,2,3,'#4a2060',s);
  px(ctx,10,1,2,3,'#4a2060',s);
  // Eyes
  px(ctx,6,5,2,1,'#ff0000',s);
  px(ctx,9,5,2,1,'#ff0000',s);
  // Fangs
  px(ctx,7,7,1,2,'#ffffff',s);
  px(ctx,9,7,1,2,'#ffffff',s);
  // Wings
  if(flap){
    px(ctx,0,4,5,4,ch.wingColor,s);
    px(ctx,11,4,5,4,ch.wingColor,s);
    px(ctx,0,3,3,2,'#4a2060',s);
    px(ctx,13,3,3,2,'#4a2060',s);
  } else {
    px(ctx,0,7,5,4,ch.wingColor,s);
    px(ctx,11,7,5,4,ch.wingColor,s);
    px(ctx,0,8,3,2,'#4a2060',s);
    px(ctx,13,8,3,2,'#4a2060',s);
  }
}

function drawKnight(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Armor body
  px(ctx,3,6,10,7,ch.color,s);
  // Helmet
  px(ctx,4,2,8,5,ch.color,s);
  // Visor
  px(ctx,5,4,6,2,'#404040',s);
  px(ctx,6,4,4,2,'#202020',s);
  // Plume
  px(ctx,6,0,4,3,'#cc0000',s);
  // Shield (wing)
  if(flap){ px(ctx,0,4,4,6,ch.accent,s); px(ctx,1,5,2,4,'#c00000',s); }
  else { px(ctx,0,6,4,6,ch.accent,s); px(ctx,1,7,2,4,'#c00000',s); }
  // Sword
  px(ctx,12,3,2,9,'#c0c0c0',s);
  px(ctx,11,5,4,1,ch.accent,s);
  // Boots
  px(ctx,3,12,4,2,'#504030',s);
  px(ctx,9,12,4,2,'#504030',s);
}

function drawFairy(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Dress body
  px(ctx,5,6,6,6,ch.color,s);
  // Head
  px(ctx,5,2,6,5,ch.accent,s);
  // Hair
  px(ctx,4,2,8,2,'#ffdd00',s);
  px(ctx,3,3,2,3,'#ffdd00',s);
  px(ctx,11,3,2,3,'#ffdd00',s);
  // Eyes
  px(ctx,6,4,2,2,'#ff80c0',s);
  px(ctx,9,4,2,2,'#ff80c0',s);
  // Wings (translucent)
  if(flap){
    ctx.globalAlpha=0.7; px(ctx,0,2,5,6,ch.wingColor,s); px(ctx,11,2,5,6,ch.wingColor,s); ctx.globalAlpha=1;
    px(ctx,1,3,3,4,'#ffffff',s);
  } else {
    ctx.globalAlpha=0.7; px(ctx,0,5,5,6,ch.wingColor,s); px(ctx,11,5,5,6,ch.wingColor,s); ctx.globalAlpha=1;
  }
  // Wand
  px(ctx,12,4,1,8,'#c8a000',s);
  px(ctx,11,3,3,2,'#ffff80',s);
  // Glow
  ctx.globalAlpha=0.15;
  px(ctx,2,1,12,12,'#ffaaff',s);
  ctx.globalAlpha=1;
}

function drawValkyrie(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Armor
  px(ctx,4,5,8,8,ch.color,s);
  // Head/helmet
  px(ctx,4,2,8,4,ch.color,s);
  // Helmet wings
  if(flap){ px(ctx,2,1,3,4,ch.accent,s); px(ctx,11,1,3,4,ch.accent,s); }
  else { px(ctx,2,3,3,4,ch.accent,s); px(ctx,11,3,3,4,ch.accent,s); }
  // Face
  px(ctx,5,3,6,3,'#f0c080',s);
  // Eyes
  px(ctx,6,4,1,1,'#4040ff',s);
  px(ctx,9,4,1,1,'#4040ff',s);
  // Spear
  px(ctx,13,0,2,14,'#c0c0c0',s);
  px(ctx,13,0,3,1,'#c0a000',s);
  // Shield
  px(ctx,0,4,4,7,ch.accent,s);
  px(ctx,1,5,2,5,'#c0a000',s);
  // Cape
  px(ctx,2,6,3,7,'#cc0000',s);
}

function drawPhoenix(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Body
  px(ctx,4,5,8,6,ch.color,s);
  // Head
  px(ctx,8,3,5,4,ch.color,s);
  // Beak
  px(ctx,12,4,2,2,'#ffcc00',s);
  // Eye
  px(ctx,10,4,2,2,'#ffff00',s);
  px(ctx,10,4,1,1,'#000',s);
  // Crest
  px(ctx,8,1,2,3,'#ff4000',s);
  px(ctx,10,0,2,2,'#ffcc00',s);
  // Wings (fiery)
  if(flap){
    px(ctx,0,2,5,6,ch.wingColor,s);
    px(ctx,0,1,3,3,ch.accent,s);
    px(ctx,0,7,4,2,'#ff0000',s);
  } else {
    px(ctx,0,6,5,6,ch.wingColor,s);
    px(ctx,0,8,4,2,'#ff0000',s);
  }
  // Tail feathers
  px(ctx,0,8,5,2,'#ffcc00',s);
  px(ctx,0,10,4,2,'#ff8000',s);
  px(ctx,0,12,3,2,'#ff4000',s);
  // Fire glow
  ctx.globalAlpha=0.2;
  px(ctx,1,4,10,8,'#ff8000',s);
  ctx.globalAlpha=1;
}

function drawRogue(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Body/cloak
  px(ctx,3,5,10,8,ch.color,s);
  // Hood
  px(ctx,3,2,10,4,ch.color,s);
  px(ctx,4,1,8,2,ch.color,s);
  // Face in shadow
  px(ctx,5,3,6,3,'#1a1a2a',s);
  // Eyes glowing
  px(ctx,6,4,2,1,ch.accent,s);
  px(ctx,9,4,2,1,ch.accent,s);
  // Daggers
  if(flap){ px(ctx,0,4,2,6,'#c0c0c0',s); px(ctx,14,4,2,6,'#c0c0c0',s); }
  else { px(ctx,1,6,2,6,'#c0c0c0',s); px(ctx,13,6,2,6,'#c0c0c0',s); }
  // Belt
  px(ctx,3,9,10,1,'#604020',s);
  px(ctx,7,9,2,2,'#c0a000',s);
}

function drawMonk(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Robe
  px(ctx,4,5,8,8,ch.color,s);
  // Head
  px(ctx,5,2,6,4,ch.accent,s);
  // Eyes closed/calm
  px(ctx,6,4,2,1,'#604020',s);
  px(ctx,9,4,2,1,'#604020',s);
  // Serene smile
  px(ctx,7,6,3,1,'#c08040',s);
  // Prayer beads
  px(ctx,3,7,1,1,'#ffaa00',s);
  px(ctx,3,9,1,1,'#ffaa00',s);
  px(ctx,3,11,1,1,'#ffaa00',s);
  // Hands (ki energy)
  if(flap){
    px(ctx,1,5,3,3,ch.accent,s);
    px(ctx,12,5,3,3,ch.accent,s);
    ctx.globalAlpha=0.4; px(ctx,0,4,4,5,'#ffffaa',s); ctx.globalAlpha=1;
  } else {
    px(ctx,1,8,3,3,ch.accent,s);
    px(ctx,12,8,3,3,ch.accent,s);
  }
  // Belt
  px(ctx,4,9,8,1,'#604020',s);
}

// ---- Mermaid ----
function drawMermaid(ctx, ch, s, frame) {
  var flap = frame % 2;
  // Tail fin (instead of legs)
  px(ctx,4,11,8,4,ch.wingColor,s);
  px(ctx,2,13,4,2,ch.wingColor,s);
  px(ctx,10,13,4,2,ch.wingColor,s);
  // Body
  px(ctx,4,5,8,7,ch.color,s);
  // Head
  px(ctx,5,2,6,4,ch.accent,s);
  // Hair flowing
  px(ctx,4,2,2,6,'#00ccaa',s);
  px(ctx,11,2,2,5,'#00ccaa',s);
  px(ctx,4,1,8,2,'#00ffee',s);
  // Eyes
  px(ctx,6,3,2,2,'#004488',s);
  px(ctx,9,3,2,2,'#004488',s);
  // Smile
  px(ctx,7,5,3,1,'#006699',s);
  // Fins / wings
  if(flap){
    ctx.globalAlpha=0.7; px(ctx,0,4,4,5,ch.wingColor,s); px(ctx,12,4,4,5,ch.wingColor,s); ctx.globalAlpha=1;
  } else {
    ctx.globalAlpha=0.7; px(ctx,0,6,4,5,ch.wingColor,s); px(ctx,12,6,4,5,ch.wingColor,s); ctx.globalAlpha=1;
  }
  // Water sparkle
  ctx.globalAlpha=0.4; px(ctx,1,9,2,1,'#00ffee',s); px(ctx,13,7,2,1,'#00ffee',s); ctx.globalAlpha=1;
}

// ---- Minotaur ----
function drawMinotaur(ctx, ch, s, frame) {
