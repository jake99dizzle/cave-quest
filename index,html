// ---- CHARACTER SELECT SCREEN ----
// Grid: 4 columns × 3 rows = 12 slots for 12 characters
var CS_COLS = 4, CS_ROWS = 3;
function getCharSelectLayout(W, H) {
  var pad = W * 0.025;
  var headerH = H * 0.11;
  var footerH = H * 0.09;
  var gridW = W - pad*2;
  var gridH = H - headerH - footerH - pad*2;
  var cellW = gridW / CS_COLS;
  var cellH = gridH / CS_ROWS;
  return { pad:pad, headerH:headerH, footerH:footerH, gridW:gridW, gridH:gridH, cellW:cellW, cellH:cellH, gridTop: headerH + pad };
}

function drawCharSelect() {
  var W = canvas.width, H = canvas.height;
  drawCave(scrollX);
  var L = getCharSelectLayout(W, H);
  var hs = getHighScore();

  // Header
  ctx.save();
  ctx.fillStyle = 'rgba(8,0,18,0.94)';
  roundRect(ctx, L.pad, L.pad*0.5, W-L.pad*2, L.headerH-L.pad*0.5, 10);
  ctx.fill();
  ctx.strokeStyle = '#7c4dff'; ctx.lineWidth = 2;
  roundRect(ctx, L.pad, L.pad*0.5, W-L.pad*2, L.headerH-L.pad*0.5, 10);
  ctx.stroke();
  ctx.textAlign = 'center';
  ctx.font = Math.floor(H*0.038) + 'px "Press Start 2P"';
  ctx.fillStyle = '#00e5ff';
  ctx.fillText('CHOOSE', W/2, L.headerH*0.70);
  ctx.restore();

  // Character cells
  for(var i=0; i<CHARACTERS.length; i++){
    var col = i % CS_COLS, row = Math.floor(i / CS_COLS);
    var cellX = L.pad + col * L.cellW;
    var cellY = L.gridTop + row * L.cellH;
    var cx = cellX + L.cellW/2;
    var cy = cellY + L.cellH/2;
    var unlocked = hs >= CHARACTERS[i].unlockScore;

    // Cell background
    ctx.save();
    ctx.fillStyle = unlocked ? 'rgba(20,0,45,0.85)' : 'rgba(5,0,12,0.85)';
    roundRect(ctx, cellX+2, cellY+2, L.cellW-4, L.cellH-4, 7);
    ctx.fill();
    // Border
    if(i === state.selectedChar && unlocked) {
      ctx.strokeStyle = '#ffcc00'; ctx.lineWidth = 2.5;
    } else {
      ctx.strokeStyle = unlocked ? 'rgba(124,77,255,0.5)' : 'rgba(80,40,100,0.22)';
      ctx.lineWidth = 1.2;
    }
    roundRect(ctx, cellX+2, cellY+2, L.cellW-4, L.cellH-4, 7);
    ctx.stroke();
    ctx.restore();

    // Sprite — occupies top 50% of cell
    var spriteSize = L.cellH * 0.44;
    var spriteX = cx - spriteSize/2;
    var spriteY = cellY + L.cellH*0.04;
    ctx.save();
    ctx.translate(spriteX, spriteY);
    if(!unlocked) ctx.globalAlpha = 0.14;
    drawPixelChar(ctx, CHARACTERS[i], 0, 0, spriteSize, Math.floor(Date.now()/400));
    ctx.restore();

    if(!unlocked) {
      // Lock + score
      ctx.save();
      ctx.textAlign = 'center';
      ctx.font = Math.floor(L.cellH*0.26) + 'px sans-serif';
      ctx.fillText('🔒', cx, cy + L.cellH*0.06);
      var lfs = Math.floor(L.cellW*0.13);
      ctx.font = lfs + 'px "Press Start 2P"';
      ctx.fillStyle = '#ff9900';
      var scoreStr = '' + CHARACTERS[i].unlockScore;
      while(ctx.measureText(scoreStr).width > L.cellW*0.82 && lfs > 4) { lfs--; ctx.font = lfs+'px "Press Start 2P"'; }
      ctx.fillText(scoreStr, cx, cellY + L.cellH*0.88);
      ctx.restore();
    } else {
      // Two text lines: Name / Type — auto-sized to fit cell width
      ctx.save();
      ctx.textAlign = 'center';
      var maxTW = L.cellW * 0.88;
      var nfs = Math.floor(L.cellH * 0.115);
      ctx.font = nfs + 'px "Press Start 2P"';
      var widerWord = (CHARACTERS[i].name.length >= CHARACTERS[i].type.length) ? CHARACTERS[i].name : CHARACTERS[i].type;
      while(ctx.measureText(widerWord).width > maxTW && nfs > 5) { nfs--; ctx.font = nfs+'px "Press Start 2P"'; }
      var nameCol = (i === state.selectedChar) ? '#ffcc00' : '#e8e8ff';
      var typeCol = (i === state.selectedChar) ? '#ffd740' : '#9999bb';
      var nameY = cellY + L.cellH * 0.64;
      ctx.fillStyle = nameCol;
      ctx.fillText(CHARACTERS[i].name, cx, nameY);
      ctx.fillStyle = typeCol;
      ctx.fillText(CHARACTERS[i].type, cx, nameY + nfs*1.75);
      ctx.restore();
    }
  }

  // TAP TO PLAY footer
  var footerY = L.gridTop + L.gridH + L.pad*0.5;
  ctx.save();
  ctx.fillStyle = 'rgba(8,0,18,0.88)';
  roundRect(ctx, L.pad, footerY, W-L.pad*2, H-footerY-L.pad*0.5, 10);
  ctx.fill();
  ctx.strokeStyle = '#7c4dff'; ctx.lineWidth = 1.5;
  roundRect(ctx, L.pad, footerY, W-L.pad*2, H-footerY-L.pad*0.5, 10);
  ctx.stroke();
  ctx.textAlign = 'center';
  ctx.font = Math.floor(H*0.026) + 'px "Press Start 2P"';
  ctx.fillStyle = '#ffffff';
  ctx.globalAlpha = 0.6 + Math.sin(Date.now()*0.004)*0.4;
  ctx.fillText('TAP TO PLAY', W/2, footerY + (H-footerY-L.pad*0.5)*0.62);
  ctx.restore();
}

// ---- GAME SCREEN ----
function drawGame() {
  var W = canvas.width, H = canvas.height;
  drawCave(scrollX);
  drawObstacles();
  drawParticles();

  // Draw player
  ctx.save();
  if(!player.alive) {
    ctx.translate(player.x, player.y);
    ctx.rotate(player.rotation);
    ctx.translate(-player.size/2, -player.size/2);
    ctx.globalAlpha = Math.max(0, 1 - player.deathTimer/40);
  } else {
    ctx.translate(player.x - player.size/2, player.y - player.size/2);
  }
  drawPixelChar(ctx, CHARACTERS[state.selectedChar], 0, 0, player.size, player.frame);
  ctx.restore();

  // Score HUD
  scoreDisplay.style.display = 'block';
  var nextHint = '';
  for(var ni=0; ni<CHARACTERS.length; ni++){
    if(state.score < CHARACTERS[ni].unlockScore && !isUnlocked(ni)) {
      nextHint = '  🔒' + CHARACTERS[ni].unlockScore;
      break;
    }
  }
  scoreDisplay.textContent = 'SCORE: ' + state.score + '   BEST: ' + state.highScore + nextHint;
}

// ---- GAME OVER SCREEN ----
function drawGameOver() {
  var W = canvas.width, H = canvas.height;
  drawCave(scrollX);
  drawParticles();

  // Hide the in-game score HUD so it doesn't overlay
  scoreDisplay.style.display = 'none';

  // Box: full readable area with safe padding
  var boxX = W*0.08, boxY = H*0.06, boxW = W*0.84, boxH = H*0.88;
  ctx.save();
  ctx.fillStyle = 'rgba(5,0,15,0.92)';
  roundRect(ctx, boxX, boxY, boxW, boxH, 14);
  ctx.fill();
  ctx.strokeStyle = state.newUnlock >= 0 ? '#ffcc00' : '#ff4444';
  ctx.lineWidth = 3;
  roundRect(ctx, boxX, boxY, boxW, boxH, 14);
  ctx.stroke();
  ctx.restore();

  ctx.save();
  ctx.textAlign = 'center';

  if(state.newUnlock >= 0) {
    // UNLOCK screen
    ctx.font = Math.floor(H*0.036) + 'px "Press Start 2P"';
    ctx.fillStyle = '#ffcc00';
    ctx.shadowColor = '#ffcc00'; ctx.shadowBlur = 18;
    ctx.fillText('UNLOCKED!', W/2, H*0.17);
    ctx.shadowBlur = 0;
    ctx.restore();
    ctx.save();
    var ulSize = H * 0.14;
    ctx.translate(W/2 - ulSize/2, H*0.19);
    drawPixelChar(ctx, CHARACTERS[state.newUnlock], 0, 0, ulSize, Math.floor(Date.now()/400));
    ctx.restore();
    ctx.save(); ctx.textAlign='center';
    ctx.font = Math.floor(H*0.020) + 'px "Press Start 2P"';
    ctx.fillStyle = '#ffcc00';
    ctx.fillText(fullName(CHARACTERS[state.newUnlock]), W/2, H*0.37);
  } else {
    // GAME OVER screen
    ctx.font = Math.floor(H*0.048) + 'px "Press Start 2P"';
    ctx.fillStyle = '#ff4444';
    ctx.shadowColor = '#ff4444'; ctx.shadowBlur = 14;
    ctx.fillText('GAME OVER', W/2, H*0.17);
    ctx.shadowBlur = 0;
    ctx.restore();
    ctx.save();
    var iconSize = H * 0.12;
    ctx.translate(W/2 - iconSize/2, H*0.19);
    drawPixelChar(ctx, CHARACTERS[state.selectedChar], 0, 0, iconSize, 0);
    ctx.restore();
    ctx.save(); ctx.textAlign='center';
    ctx.font = Math.floor(H*0.019) + 'px "Press Start 2P"';
    ctx.fillStyle = '#aaaacc';
    ctx.fillText(fullName(CHARACTERS[state.selectedChar]), W/2, H*0.36);
  }

  // Score
  ctx.font = Math.floor(H*0.030) + 'px "Press Start 2P"';
  ctx.fillStyle = '#ffffff';
  ctx.fillText('SCORE: ' + state.lastScore, W/2, H*0.46);

  // Best
  if(state.lastScore >= state.highScore && state.lastScore > 0) {
    ctx.fillStyle = '#ffcc00';
    ctx.shadowColor='#ffcc00'; ctx.shadowBlur=10;
    ctx.fillText('NEW BEST!', W/2, H*0.54);
    ctx.shadowBlur=0;
  } else {
    ctx.fillStyle = '#7c4dff';
    ctx.fillText('BEST: ' + state.highScore, W/2, H*0.54);
  }

  // Next unlock hint
  var nextUnlock = null;
  var hs2 = getHighScore();
  for(var ni=0; ni<CHARACTERS.length; ni++){
    if(hs2 < CHARACTERS[ni].unlockScore) { nextUnlock = CHARACTERS[ni]; break; }
  }
  ctx.font = Math.floor(H*0.015) + 'px "Press Start 2P"';
  if(nextUnlock) {
    ctx.fillStyle = '#ff9900';
    ctx.fillText('NEXT: ' + fullName(nextUnlock) + ' @ ' + nextUnlock.unlockScore, W/2, H*0.62);
  } else {
    ctx.fillStyle = '#00e5ff';
    ctx.fillText('ALL CHARACTERS UNLOCKED!', W/2, H*0.62);
  }

  // Buttons — safely inside box, well above bottom edge
  var btnW = W * 0.64;
  var btnH = H * 0.072;
  var btnX = W/2 - btnW/2;
  drawButton(ctx, btnX, H*0.69, btnW, btnH, 'TRY AGAIN', '#7c4dff', '#ffffff');
  drawButton(ctx, btnX, H*0.79, btnW, btnH, 'CHANGE CHARACTER', '#ff4444', '#ffffff');
  ctx.restore();
}

function drawButton(ctx, x, y, w, h, label, bg, fg) {
  ctx.save();
  ctx.fillStyle = bg;
  roundRect(ctx, x, y, w, h, 6); ctx.fill();
  ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 2;
  roundRect(ctx, x, y, w, h, 6); ctx.stroke();
  ctx.fillStyle = fg;
  ctx.textAlign = 'center';
  // Start at a comfortable size and shrink until it fits
  var fontSize = Math.floor(h * 0.28);
  ctx.font = fontSize + 'px "Press Start 2P"';
  while(ctx.measureText(label).width > w * 0.82 && fontSize > 6) {
    fontSize--;
    ctx.font = fontSize + 'px "Press Start 2P"';
  }
  ctx.fillText(label, x + w/2, y + h*0.64);
  ctx.restore();
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x+r, y);
  ctx.lineTo(x+w-r, y); ctx.arcTo(x+w,y,x+w,y+r,r);
  ctx.lineTo(x+w,y+h-r); ctx.arcTo(x+w,y+h,x+w-r,y+h,r);
  ctx.lineTo(x+r,y+h); ctx.arcTo(x,y+h,x,y+h-r,r);
  ctx.lineTo(x,y+r); ctx.arcTo(x,y,x+r,y,r);
  ctx.closePath();
}

function handleTap(ex, ey) {
  if(state.screen === 'title') {
    state.screen = 'charselect';

  } else if(state.screen === 'charselect') {
    var W = canvas.width, H = canvas.height;
    var L = getCharSelectLayout(W, H);
    // Check each character cell
    for(var i=0; i<CHARACTERS.length; i++){
      var col = i % CS_COLS, row = Math.floor(i / CS_COLS);
      var cellX = L.pad + col * L.cellW;
      var cellY = L.gridTop + row * L.cellH;
      if(ex >= cellX && ex <= cellX+L.cellW && ey >= cellY && ey <= cellY+L.cellH) {
        if(isUnlocked(i)) state.selectedChar = i;
        return; // tapping a cell just selects
      }
    }
    // Tap on footer (TAP TO PLAY area) starts game
    var footerY = L.gridTop + L.gridH + L.pad*0.5;
    if(ey >= footerY) {
      state.screen = 'game';
      scoreDisplay.style.display = 'block';
      initGame();
    }

  } else if(state.screen === 'game') {
    if(player.alive) {
      player.vy = -FLAP_FORCE;
      playFlap();
    }

  } else if(state.screen === 'gameover') {
    var W2 = canvas.width, H2 = canvas.height;
    var btnW2 = W2 * 0.64;
    var btnX2 = W2/2 - btnW2/2;
    var btnH2 = H2 * 0.072;
    if(ex >= btnX2 && ex <= btnX2+btnW2 && ey >= H2*0.69 && ey <= H2*0.69+btnH2) {
      state.screen = 'game';
      initGame();
    } else if(ex >= btnX2 && ex <= btnX2+btnW2 && ey >= H2*0.79 && ey <= H2*0.79+btnH2) {
      state.screen = 'charselect';
      scoreDisplay.style.display = 'none';
      stopBGM();
    }
  }
}

canvas.addEventListener('touchstart', function(e) {
  e.preventDefault();
  var t = e.changedTouches[0];
  var rect = canvas.getBoundingClientRect();
  handleTap(t.clientX - rect.left, t.clientY - rect.top);
}, { passive: false });

canvas.addEventListener('mousedown', function(e) {
  var rect = canvas.getBoundingClientRect();
  handleTap(e.clientX - rect.left, e.clientY - rect.top);
});

document.addEventListener('keydown', function(e) {
  if(e.code === 'Space' || e.code === 'ArrowUp') {
    e.preventDefault();
    if(state.screen === 'game' && player.alive) { player.vy = -FLAP_FORCE; playFlap(); }
    else if(state.screen === 'title') { state.screen='charselect'; }
    else if(state.screen === 'charselect') { state.screen='game'; scoreDisplay.style.display='block'; initGame(); }
  }
});

// ---- Main loop ----
var lastTime = 0;
function loop(timestamp) {
  try {
    var dt = Math.min(timestamp - lastTime, 50);
    lastTime = timestamp;

    if(state.screen === 'title') {
      scrollX += 1.5;
      drawTitle();

    } else if(state.screen === 'charselect') {
      scrollX += 1.5;
      drawCharSelect();

    } else if(state.screen === 'game') {
      if(player.alive) {
        gameTime++;
        // Speed ramps from 0.0028 → 0.0060 over ~2500 frames, then plateaus
        gameSpeed = canvas.width * (0.0028 + Math.min(gameTime * 0.0000013, 0.0032));

        player.vy += GRAVITY;
        player.y += player.vy;

        // Animate character
        player.frameTimer++;
        if(player.frameTimer > 8) { player.frame = (player.frame+1)%2; player.frameTimer=0; }

        scrollX += gameSpeed;
        spawnTimer += gameSpeed;
        // Spawn interval: starts at 0.55 screen widths, tightens to 0.42 at score 50+
        var dynInterval = canvas.width * Math.max(0.42, 0.55 - state.score * 0.0026);
        if(spawnTimer >= dynInterval) {
          spawnObstacle();
          spawnTimer = 0;
        }

        updateObstacles(dt);

        if(checkCollision()) {
          player.alive = false;
          player.deathTimer = 0;
          spawnDeathParticles();
          playDeath();
          stopBGM();
          state.lastScore = state.score;
          state.newUnlock = -1;
          saveHighScore(state.score);
          state.highScore = getHighScore();
        }
      } else {
        player.deathTimer++;
        player.rotation += 0.15;
        player.y += 3;
        updateParticles();
        scoreDisplay.style.display = 'none';
        if(player.deathTimer > 80) {
          state.screen = 'gameover';
        }
      }
      drawGame();
      updateParticles();

    } else if(state.screen === 'gameover') {
      updateParticles();
      drawGameOver();
    }

  } catch(err) {
    console.error('Loop error:', err);
  }
  requestAnimationFrame(loop);
}

// ---- Boot ----
scoreDisplay.style.display = 'none';
requestAnimationFrame(loop);
</script>
