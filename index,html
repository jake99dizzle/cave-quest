function drawCave(scrollX) {
  var W = canvas.width, H = canvas.height;
  // Deep background
  var grad = ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,'#0d0018');
  grad.addColorStop(0.5,'#0a0015');
  grad.addColorStop(1,'#1a0810');
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,W,H);

  // Lava glow at bottom
  var lavaGrad = ctx.createLinearGradient(0,H*0.85,0,H);
  lavaGrad.addColorStop(0,'rgba(0,0,0,0)');
  lavaGrad.addColorStop(1,'rgba(200,60,0,0.3)');
  ctx.fillStyle = lavaGrad;
  ctx.fillRect(0,H*0.85,W,H*0.15);

  // Far background crystals (slow parallax)
  drawCrystals(ctx, scrollX * 0.2, W, H);

  // Mid layer - cave wall texture
  drawCaveWalls(ctx, scrollX * 0.5, W, H);

  // Foreground rocks (fast parallax)
  drawForegroundRocks(ctx, scrollX * 1.0, W, H);
}

function drawCrystals(ctx, ox, W, H) {
  var seed = 42;
  ctx.save();
  for(var i=0; i<12; i++){
    seed = (seed * 1664525 + 1013904223) & 0xffffffff;
    var x = ((Math.abs(seed) % W) + (ox * 0.3)) % W;
    seed = (seed * 1664525 + 1013904223) & 0xffffffff;
    var h2 = 20 + (Math.abs(seed) % 40);
    seed = (seed * 1664525 + 1013904223) & 0xffffffff;
    var side = seed % 2;
    var colors = ['#00e5ff','#7c4dff','#40c0a0','#00bcd4'];
    var col = colors[Math.abs(seed) % colors.length];
    ctx.fillStyle = col;
    ctx.globalAlpha = 0.3 + (Math.abs(seed) % 30) / 100;
    var cx = x % W;
    if(side === 0) {
      ctx.beginPath(); ctx.moveTo(cx,0); ctx.lineTo(cx-6,h2); ctx.lineTo(cx+6,h2); ctx.closePath(); ctx.fill();
    } else {
      ctx.beginPath(); ctx.moveTo(cx,H); ctx.lineTo(cx-6,H-h2); ctx.lineTo(cx+6,H-h2); ctx.closePath(); ctx.fill();
    }
  }
  ctx.globalAlpha = 1;
  ctx.restore();
}

function drawCaveWalls(ctx, ox, W, H) {
  // Top rock silhouette
  ctx.fillStyle = '#1a0f28';
  ctx.beginPath();
  ctx.moveTo(0,0);
  var topH = H * 0.12;
  for(var x=0; x<=W; x+=20){
    var nx = (x + ox) % (W*2);
    var y = topH + Math.sin(nx*0.05)*10 + Math.sin(nx*0.02)*15;
    ctx.lineTo(x,y);
  }
  ctx.lineTo(W,0); ctx.closePath(); ctx.fill();

  // Bottom rock silhouette
  ctx.fillStyle = '#1a0f28';
  ctx.beginPath();
  ctx.moveTo(0,H);
  var botH = H * 0.12;
  for(var x2=0; x2<=W; x2+=20){
    var nx2 = (x2 + ox) % (W*2);
    var y2 = H - botH - Math.sin(nx2*0.04)*12 - Math.sin(nx2*0.03)*8;
    ctx.lineTo(x2,y2);
  }
  ctx.lineTo(W,H); ctx.closePath(); ctx.fill();

  // Torches
  drawTorches(ctx, ox, W, H);
}

var torchFlicker = 0;
function drawTorches(ctx, ox, W, H) {
  torchFlicker += 0.1;
  var positions = [0.15, 0.45, 0.75];
  for(var i=0; i<positions.length; i++){
    var tx = ((positions[i]*W*2 - ox) % W + W) % W;
    var ty = H*0.14;
    // Torch stick
    ctx.fillStyle = '#8B4513';
    ctx.fillRect(tx-3, ty, 6, 18);
    // Flame
    var flameH = 16 + Math.sin(torchFlicker + i*2)*4;
    var flameGrad = ctx.createRadialGradient(tx, ty, 1, tx, ty, flameH);
    flameGrad.addColorStop(0,'rgba(255,255,100,0.9)');
    flameGrad.addColorStop(0.5,'rgba(255,120,0,0.7)');
    flameGrad.addColorStop(1,'rgba(255,60,0,0)');
    ctx.fillStyle = flameGrad;
    ctx.beginPath();
    ctx.ellipse(tx, ty - flameH/2, 8, flameH/2, 0, 0, Math.PI*2);
    ctx.fill();

    // Bottom torches
    var ty2 = H - H*0.14 - 18;
    ctx.fillStyle = '#8B4513';
    ctx.fillRect(tx-3, ty2, 6, 18);
    var flameGrad2 = ctx.createRadialGradient(tx, ty2+18, 1, tx, ty2+18, flameH);
    flameGrad2.addColorStop(0,'rgba(255,255,100,0.9)');
    flameGrad2.addColorStop(0.5,'rgba(255,120,0,0.7)');
    flameGrad2.addColorStop(1,'rgba(255,60,0,0)');
    ctx.fillStyle = flameGrad2;
    ctx.beginPath();
    ctx.ellipse(tx, ty2+18+flameH/2, 8, flameH/2, 0, 0, Math.PI*2);
    ctx.fill();
  }
}

function drawForegroundRocks(ctx, ox, W, H) {
  ctx.fillStyle = '#0d0818';
  // Top rocks
  ctx.beginPath(); ctx.moveTo(0,0);
  for(var x=0; x<=W+30; x+=30){
    var nx = ((x + ox) % (W*1.5));
    var y = H*0.08 + Math.sin(nx*0.08)*8 + Math.cos(nx*0.06)*6;
    ctx.lineTo(x, y);
  }
  ctx.lineTo(W,0); ctx.closePath(); ctx.fill();

  // Bottom rocks
  ctx.beginPath(); ctx.moveTo(0,H);
  for(var x2=0; x2<=W+30; x2+=30){
    var nx2 = ((x2 + ox*1.2) % (W*1.5));
    var y2 = H - H*0.08 - Math.sin(nx2*0.07)*8 - Math.cos(nx2*0.05)*5;
    ctx.lineTo(x2, y2);
  }
  ctx.lineTo(W,H); ctx.closePath(); ctx.fill();
}

// ---- Game state ----
var state = {
  screen: 'title',   // 'title' | 'charselect' | 'game' | 'gameover'
  selectedChar: 0,
  score: 0,
  highScore: getHighScore(),
  lastScore: 0,
  newUnlock: -1
};

// ---- Player ----
var player = {
  x: 0, y: 0,
  vy: 0,
  size: 0,
  alive: true,
  frame: 0,
  frameTimer: 0,
  deathTimer: 0,
  rotation: 0
};

// ---- Obstacles ----
var obstacles = [];
var scrollX = 0;
var gameSpeed = 0;
var spawnTimer = 0;
var gameTime = 0;
var GRAVITY = 0;
var FLAP_FORCE = 0;

function initGame() {
  var H = canvas.height, W = canvas.width;
  player.x = W * 0.2;
  player.y = H / 2;
  player.vy = 0;
  player.size = Math.min(W, H) * 0.07;
  player.alive = true;
  player.frame = 0;
  player.frameTimer = 0;
  player.deathTimer = 0;
  player.rotation = 0;
  obstacles = [];
  scrollX = 0;
  gameSpeed = W * 0.0028;
  // Pre-fill so first obstacle arrives quickly (~1.5s)
  spawnTimer = W * 0.35;
  gameTime = 0;
  state.score = 0;
  state.newUnlock = -1;
  GRAVITY = 0.38;
  FLAP_FORCE = 7.5;
  if(soundOn) startBGM();
}

// ---- Obstacle types ----
function getActiveObstacleTypes() {
  var score = state.score;
  var types = ['stalactite'];
  if(score >= 5)  types.push('slime');
  if(score >= 10) types.push('spider');
  if(score >= 25) types.push('imp');
  if(score >= 35) types.push('spikedwall');
  if(score >= 50) types.push('skeleton');
  if(score >= 75) types.push('zombie');
  return types;
}

function spawnObstacle() {
  var W = canvas.width, H = canvas.height;
  var types = getActiveObstacleTypes();
  var type = types[Math.floor(Math.random() * types.length)];
  var safeTop = H * 0.15;
  var safeBot = H * 0.85;
  var playH = safeBot - safeTop;

  // Gap starts very wide (62% of play area) and shrinks to 36% at score 100+
  var gapFraction = Math.max(0.36, 0.62 - state.score * 0.0026);
  var minGap = playH * gapFraction;
  var maxGap = playH * (gapFraction + 0.10);

  if(type === 'stalactite') {
    var gap = minGap + Math.random() * (maxGap - minGap);
    var topH = safeTop + Math.random() * (playH - gap);
    var botY = topH + gap;
    obstacles.push({ type:'stalactite', x: W+40, topH: topH, botY: botY, w: 40, scored: false });
  } else if(type === 'slime') {
    // Spawn at a random height within the play area (with some padding so it's reachable)
    var slimeY = safeTop + playH * (0.15 + Math.random() * 0.70);
    obstacles.push({ type:'slime', x: W+40, y: slimeY, w:32, h:28, scored:false, animT:0 });
  } else if(type === 'spider') {
    var sx = W + 20 + Math.random()*W*0.2;
    var maxWebLen = playH * (0.25 + Math.min(state.score * 0.003, 0.2));
    obstacles.push({ type:'spider', x:sx, y:safeTop, webLen: maxWebLen * (0.5 + Math.random()*0.5), w:22, animT:0, scored:false, vel:0.6+Math.random()*0.5, dir:1 });
  } else if(type === 'boulder') {
    obstacles.push({ type:'boulder', x: W*0.4+Math.random()*W*0.4, y: safeTop-30, r:18+Math.random()*14, vy:1.5+Math.random()*2, scored:false });
  } else if(type === 'imp') {
    var iy = safeTop + Math.random()*playH*0.6;
    var waveAmp = playH * Math.min(0.06 + state.score * 0.0012, 0.18);
    obstacles.push({ type:'imp', x: W+30, y: iy, w:24, h:24, animT:0, scored:false, waveAmp: waveAmp, waveFreq:0.04, startY:iy });
  } else if(type === 'spikedwall') {
    var wallY = safeTop + Math.random()*(playH*0.5);
    var wallH = playH * Math.min(0.22 + state.score * 0.002, 0.42);
    obstacles.push({ type:'spikedwall', x: W+20, y: wallY, w:22, h: wallH, scored:false, vyDir:1, vySpeed:1.5 });
  } else if(type === 'skeleton') {
    var skelY = safeTop + playH * (0.2 + Math.random() * 0.6);
    obstacles.push({ type:'skeleton', x: W+30, y: skelY, w:28, h:40, animT:0, scored:false, throwTimer:80, boneX:-1, boneY:skelY+15 });
  } else if(type === 'zombie') {
    var zombY = safeTop + playH * (0.2 + Math.random() * 0.6);
    obstacles.push({ type:'zombie', x: W+30, y: zombY, w:36, h:44, animT:0, scored:false });
  }
}

function updateObstacles(dt) {
  var W = canvas.width, H = canvas.height;
  var safeBot = H * 0.85;
  for(var i = obstacles.length-1; i>=0; i--) {
    var o = obstacles[i];

    if(o.type === 'stalactite') {
      o.x -= gameSpeed;
      if(!o.scored && o.x + o.w < player.x) {
        o.scored = true; state.score++; playScore();
      }
      if(o.x < -o.w*2) obstacles.splice(i,1);

    } else if(o.type === 'slime') {
      o.x -= gameSpeed * 0.7;
      o.animT += 0.1;
      if(!o.scored && o.x + o.w < player.x) { o.scored=true; state.score++; playScore(); }
      if(o.x < -40) obstacles.splice(i,1);

    } else if(o.type === 'spider') {
      o.x -= gameSpeed * 0.5;
      o.animT += 0.05;
      o.y += o.vel * o.dir;
      if(o.y > o.webLen + H*0.15 || o.y < H*0.15) o.dir *= -1;
      if(!o.scored && o.x < player.x) { o.scored=true; state.score++; playScore(); }
      if(o.x < -40) obstacles.splice(i,1);

    } else if(o.type === 'imp') {
      o.x -= gameSpeed * 1.2;
      o.animT += 0.08;
      o.y = o.startY + Math.sin(o.x * o.waveFreq) * o.waveAmp;
      if(!o.scored && o.x < player.x) { o.scored=true; state.score++; playScore(); }
      if(o.x < -40) obstacles.splice(i,1);

    } else if(o.type === 'spikedwall') {
      o.x -= gameSpeed * 0.8;
      o.y += o.vyDir * o.vySpeed;
      if(o.y < H*0.15 || o.y + o.h > H*0.85) o.vyDir *= -1;
      if(!o.scored && o.x < player.x) { o.scored=true; state.score++; playScore(); }
      if(o.x < -40) obstacles.splice(i,1);

    } else if(o.type === 'skeleton') {
      o.x -= gameSpeed * 0.6;
      o.animT += 0.1;
      o.throwTimer--;
      if(o.boneX > 0) { o.boneX -= gameSpeed * 2.5; if(o.boneX < 0) o.boneX = -1; }
      else if(o.throwTimer <= 0) { o.boneX = o.x; o.boneY = o.y + 15; o.throwTimer = 80; }
      if(!o.scored && o.x < player.x) { o.scored=true; state.score++; playScore(); }
      if(o.x < -50) obstacles.splice(i,1);

    } else if(o.type === 'zombie') {
      o.x -= gameSpeed * 0.4;
      o.animT += 0.07;
      if(!o.scored && o.x < player.x) { o.scored=true; state.score++; playScore(); }
      if(o.x < -50) obstacles.splice(i,1);
    }
  }
}

function drawObstacles() {
  var H = canvas.height;
  for(var i=0; i<obstacles.length; i++) {
    var o = obstacles[i];
    drawObstacle(o, H);
  }
}

function drawObstacle(o, H) {
  ctx.save();
  if(o.type === 'stalactite') {
    // Top stalactite
    ctx.fillStyle = '#3d2060';
    var tw = o.w;
    ctx.beginPath();
    ctx.moveTo(o.x, 0);
    ctx.lineTo(o.x + tw, 0);
    ctx.lineTo(o.x + tw, o.topH - 20);
    ctx.lineTo(o.x + tw/2, o.topH);
    ctx.lineTo(o.x, o.topH - 20);
    ctx.closePath(); ctx.fill();
    // Crystal tip
    ctx.fillStyle = '#00e5ff';
    ctx.beginPath();
    ctx.moveTo(o.x + tw/2 - 5, o.topH - 15);
    ctx.lineTo(o.x + tw/2 + 5, o.topH - 15);
    ctx.lineTo(o.x + tw/2, o.topH + 2);
    ctx.closePath(); ctx.fill();
    // Bottom stalagmite
    ctx.fillStyle = '#3d2060';
    ctx.beginPath();
    ctx.moveTo(o.x, H);
    ctx.lineTo(o.x + tw, H);
    ctx.lineTo(o.x + tw, o.botY + 20);
    ctx.lineTo(o.x + tw/2, o.botY);
    ctx.lineTo(o.x, o.botY + 20);
    ctx.closePath(); ctx.fill();
    ctx.fillStyle = '#00e5ff';
    ctx.beginPath();
    ctx.moveTo(o.x + tw/2 - 5, o.botY + 15);
    ctx.lineTo(o.x + tw/2 + 5, o.botY + 15);
    ctx.lineTo(o.x + tw/2, o.botY - 2);
    ctx.closePath(); ctx.fill();

  } else if(o.type === 'slime') {
    var bob = Math.sin(o.animT) * 4;
    // Glow halo
    ctx.save();
    ctx.shadowColor = '#00ff88'; ctx.shadowBlur = 14;
    ctx.fillStyle = '#00ff66';
    ctx.beginPath();
    ctx.ellipse(o.x + 14, o.y + bob, 14, 12, 0, 0, Math.PI*2);
    ctx.fill();
    ctx.restore();
    // Highlight shine
    ctx.fillStyle = '#88ffcc';
    ctx.beginPath();
    ctx.ellipse(o.x + 10, o.y - 3 + bob, 5, 4, -0.4, 0, Math.PI*2);
    ctx.fill();
    // Eyes
    ctx.fillStyle = '#fff';
    ctx.fillRect(o.x+6, o.y-2+bob, 7, 7);
    ctx.fillRect(o.x+17, o.y-2+bob, 7, 7);
    ctx.fillStyle = '#000';
    ctx.fillRect(o.x+8, o.y+bob, 4, 4);
    ctx.fillRect(o.x+19, o.y+bob, 4, 4);
    // Bright outline
    ctx.strokeStyle = '#00ff44'; ctx.lineWidth=2.5;
    ctx.beginPath(); ctx.ellipse(o.x+14, o.y+bob, 14, 12, 0, 0, Math.PI*2); ctx.stroke();

  } else if(o.type === 'spider') {
    // Glowing web line
    ctx.save();
    ctx.shadowColor = '#ffffff'; ctx.shadowBlur = 6;
    ctx.strokeStyle = 'rgba(255,255,255,0.8)'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(o.x, H*0.15); ctx.lineTo(o.x, o.y); ctx.stroke();
    ctx.restore();
    // Body glow
    ctx.save();
    ctx.shadowColor = '#ff4400'; ctx.shadowBlur = 12;
    ctx.fillStyle = '#ff2200';
    ctx.beginPath(); ctx.ellipse(o.x, o.y, 11, 9, 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();
    // Head (brighter orange-red)
    ctx.fillStyle = '#ff6600';
    ctx.beginPath(); ctx.ellipse(o.x, o.y-5, 8, 7, 0, 0, Math.PI*2); ctx.fill();
    // Bright highlight
    ctx.fillStyle = '#ffaa66';
    ctx.beginPath(); ctx.ellipse(o.x-2, o.y-7, 3, 2, -0.3, 0, Math.PI*2); ctx.fill();
    // Legs — bright yellow-orange
    ctx.strokeStyle = '#ffaa00'; ctx.lineWidth = 2.5;
    for(var l=0; l<4; l++){
      var la = (l/4)*Math.PI - Math.PI*0.1;
      ctx.beginPath(); ctx.moveTo(o.x, o.y); ctx.lineTo(o.x - Math.cos(la)*20, o.y + Math.sin(la)*14 + Math.sin(o.animT+l)*3); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(o.x, o.y); ctx.lineTo(o.x + Math.cos(la)*20, o.y + Math.sin(la)*14 + Math.sin(o.animT+l)*3); ctx.stroke();
    }
    // Eyes — glowing white
    ctx.save();
    ctx.shadowColor = '#ffffff'; ctx.shadowBlur = 6;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(o.x-6, o.y-8, 4, 4);
    ctx.fillRect(o.x+2, o.y-8, 4, 4);
    ctx.restore();

  } else if(o.type === 'boulder') {
    ctx.save();
    ctx.shadowColor = '#ff8800'; ctx.shadowBlur = 10;
    ctx.fillStyle = '#c87840';
    ctx.beginPath(); ctx.arc(o.x, o.y, o.r, 0, Math.PI*2); ctx.fill();
    ctx.restore();
    ctx.fillStyle = '#e8a060';
    ctx.beginPath(); ctx.arc(o.x - o.r*0.3, o.y - o.r*0.3, o.r*0.35, 0, Math.PI*2); ctx.fill();
    // Crack lines
    ctx.strokeStyle = '#7a4020'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(o.x-4, o.y-o.r*0.5); ctx.lineTo(o.x+2, o.y+o.r*0.3); ctx.stroke();
    ctx.strokeStyle = '#ff9944'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(o.x, o.y, o.r, 0, Math.PI*2); ctx.stroke();

  } else if(o.type === 'imp') {
    var ifr = Math.floor(o.animT * 8) % 2;
    // Body
    ctx.fillStyle = '#cc2244';
    ctx.beginPath(); ctx.ellipse(o.x+12, o.y+12, 10, 12, 0, 0, Math.PI*2); ctx.fill();
    // Head
    ctx.fillStyle = '#dd3355';
    ctx.beginPath(); ctx.ellipse(o.x+12, o.y, 9, 8, 0, 0, Math.PI*2); ctx.fill();
    // Horns
    ctx.fillStyle = '#880022';
    ctx.beginPath(); ctx.moveTo(o.x+6,o.y-6); ctx.lineTo(o.x+4,o.y-14); ctx.lineTo(o.x+9,o.y-6); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(o.x+18,o.y-6); ctx.lineTo(o.x+20,o.y-14); ctx.lineTo(o.x+15,o.y-6); ctx.closePath(); ctx.fill();
    // Wings
    if(ifr){ ctx.fillStyle='rgba(150,0,50,0.7)'; ctx.beginPath(); ctx.ellipse(o.x-5,o.y+5,12,6,Math.PI*0.3,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.ellipse(o.x+29,o.y+5,12,6,-Math.PI*0.3,0,Math.PI*2); ctx.fill(); }
    else { ctx.fillStyle='rgba(150,0,50,0.7)'; ctx.beginPath(); ctx.ellipse(o.x-5,o.y+10,12,6,Math.PI*0.1,0,Math.PI*2); ctx.fill(); ctx.beginPath(); ctx.ellipse(o.x+29,o.y+10,12,6,-Math.PI*0.1,0,Math.PI*2); ctx.fill(); }
    // Eyes
    ctx.fillStyle='#ffff00'; ctx.fillRect(o.x+7,o.y-2,4,4); ctx.fillRect(o.x+13,o.y-2,4,4);
    ctx.fillStyle='#000'; ctx.fillRect(o.x+8,o.y-1,2,2); ctx.fillRect(o.x+14,o.y-1,2,2);

  } else if(o.type === 'spikedwall') {
    ctx.fillStyle = '#5a3070';
    ctx.fillRect(o.x, o.y, o.w, o.h);
    // Spikes on left side
    ctx.fillStyle = '#c0a0ff';
    var spikeCount = Math.floor(o.h / 14);
    for(var s=0; s<spikeCount; s++){
      var sy = o.y + s*14 + 2;
      ctx.beginPath(); ctx.moveTo(o.x,sy); ctx.lineTo(o.x-12,sy+6); ctx.lineTo(o.x,sy+12); ctx.closePath(); ctx.fill();
    }
    ctx.strokeStyle='#7c4dff'; ctx.lineWidth=2; ctx.strokeRect(o.x,o.y,o.w,o.h);

  } else if(o.type === 'skeleton') {
    var sfr = Math.floor(o.animT * 6) % 2;
    // Legs walk
    ctx.fillStyle = '#e0e0d0';
    if(sfr){ ctx.fillRect(o.x+6,o.y+26,8,14); ctx.fillRect(o.x+18,o.y+22,8,18); }
    else { ctx.fillRect(o.x+6,o.y+22,8,18); ctx.fillRect(o.x+18,o.y+26,8,14); }
    // Body
    ctx.fillStyle='#e0e0d0';
    ctx.fillRect(o.x+4,o.y+12,24,16);
    // Ribs
    ctx.strokeStyle='#aaaaaa'; ctx.lineWidth=1;
    for(var r=0;r<3;r++){ ctx.beginPath(); ctx.moveTo(o.x+6,o.y+14+r*4); ctx.lineTo(o.x+26,o.y+14+r*4); ctx.stroke(); }
    // Head (skull)
    ctx.fillStyle='#e8e8d8';
    ctx.beginPath(); ctx.ellipse(o.x+16,o.y+6,11,10,0,0,Math.PI*2); ctx.fill();
    // Eye sockets
    ctx.fillStyle='#222'; ctx.beginPath(); ctx.ellipse(o.x+11,o.y+5,4,4,0,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(o.x+21,o.y+5,4,4,0,0,Math.PI*2); ctx.fill();
    // Grin
    ctx.strokeStyle='#333'; ctx.lineWidth=1;
    for(var t=0;t<5;t++){ ctx.fillStyle='#e8e8d8'; ctx.fillRect(o.x+8+t*3,o.y+11,2,3); }
    // Arms
    ctx.fillStyle='#e0e0d0';
    if(sfr){ ctx.fillRect(o.x-2,o.y+12,8,5); ctx.fillRect(o.x+22,o.y+14,8,5); }
    else { ctx.fillRect(o.x-2,o.y+16,8,5); ctx.fillRect(o.x+22,o.y+12,8,5); }
    // Thrown bone
    if(o.boneX > 0) {
      ctx.fillStyle='#e8e8d8';
      ctx.save(); ctx.translate(o.boneX, o.boneY || o.y+15); ctx.rotate(o.animT*2);
      ctx.fillRect(-8,-3,16,6); ctx.fillRect(-10,-5,7,10); ctx.fillRect(3,-5,7,10);
      ctx.restore();
    }

  } else if(o.type === 'zombie') {
    var zfr = Math.floor(o.animT * 4) % 2;
    // Legs (shamble)
    ctx.fillStyle='#3a5a30';
    if(zfr){ ctx.fillRect(o.x+4,o.y+30,12,14); ctx.fillRect(o.x+20,o.y+28,12,16); }
    else { ctx.fillRect(o.x+4,o.y+28,12,16); ctx.fillRect(o.x+20,o.y+30,12,14); }
    // Body
    ctx.fillStyle='#4a6a3a'; ctx.fillRect(o.x+2,o.y+12,32,20);
    // Torn clothes
    ctx.fillStyle='#2a4a20'; ctx.fillRect(o.x+2,o.y+28,8,5); ctx.fillRect(o.x+26,o.y+26,8,5);
    // Head
    ctx.fillStyle='#7a9a60'; ctx.beginPath(); ctx.ellipse(o.x+18,o.y+6,13,11,0,0,Math.PI*2); ctx.fill();
    // Eyes (glowing)
    ctx.fillStyle='#aaff00'; ctx.beginPath(); ctx.ellipse(o.x+12,o.y+5,4,4,0,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(o.x+24,o.y+5,4,4,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#000'; ctx.beginPath(); ctx.ellipse(o.x+12,o.y+5,2,2,0,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(o.x+24,o.y+5,2,2,0,0,Math.PI*2); ctx.fill();
    // Mouth
    ctx.fillStyle='#2a1010'; ctx.fillRect(o.x+10,o.y+9,16,4);
    ctx.fillStyle='#e8e8d8'; for(var zt=0;zt<4;zt++){ ctx.fillRect(o.x+11+zt*4,o.y+9,3,3); }
    // Arms outstretched
    ctx.fillStyle='#7a9a60';
    if(zfr){ ctx.fillRect(o.x-10,o.y+12,14,7); ctx.fillRect(o.x+32,o.y+12,14,7); }
    else { ctx.fillRect(o.x-8,o.y+14,14,7); ctx.fillRect(o.x+30,o.y+14,14,7); }
    // Glow
    ctx.globalAlpha=0.15; ctx.fillStyle='#aaff00';
    ctx.beginPath(); ctx.ellipse(o.x+18,o.y+5,16,14,0,0,Math.PI*2); ctx.fill();
    ctx.globalAlpha=1;
  }
  ctx.restore();
}

// ---- Collision detection ----
function checkCollision() {
  var W = canvas.width, H = canvas.height;
  var safeTop = H * 0.13;
  var safeBot = H * 0.87;
  var pr = player.size * 0.38;
  var px2 = player.x, py = player.y;

  // Cave walls
  if(py - pr < safeTop || py + pr > safeBot) return true;

  for(var i=0; i<obstacles.length; i++) {
    var o = obstacles[i];
    if(o.type === 'stalactite') {
      if(px2 + pr > o.x - 4 && px2 - pr < o.x + o.w + 4) {
        if(py - pr < o.topH + 4 || py + pr > o.botY - 4) return true;
      }
    } else if(o.type === 'slime') {
      if(rectCircle(o.x, o.y - 12, o.w, 26, px2, py, pr)) return true;
    } else if(o.type === 'spider') {
      if(dist(px2, py, o.x, o.y) < pr + 11) return true;
    } else if(o.type === 'imp') {
      if(rectCircle(o.x, o.y-8, 24, 24, px2, py, pr)) return true;
    } else if(o.type === 'spikedwall') {
      if(rectCircle(o.x - 12, o.y, o.w + 12, o.h, px2, py, pr)) return true;
    } else if(o.type === 'skeleton') {
      if(rectCircle(o.x, o.y, 32, 40, px2, py, pr)) return true;
      if(o.boneX > 0 && rectCircle(o.boneX-8, (o.boneY||o.y+12), 16, 6, px2, py, pr)) return true;
    } else if(o.type === 'zombie') {
      if(rectCircle(o.x - 8, o.y+8, 52, 36, px2, py, pr)) return true;
    }
  }
  return false;
}

function dist(x1,y1,x2,y2){ var dx=x1-x2,dy=y1-y2; return Math.sqrt(dx*dx+dy*dy); }
function rectCircle(rx,ry,rw,rh,cx,cy,cr){
  var nx=Math.max(rx,Math.min(cx,rx+rw));
  var ny=Math.max(ry,Math.min(cy,ry+rh));
  return dist(cx,cy,nx,ny)<cr;
}

// ---- Particles ----
var particles = [];
function spawnDeathParticles() {
  var ch = CHARACTERS[state.selectedChar];
  for(var i=0; i<20; i++){
    var angle = (Math.PI*2/20)*i;
    particles.push({
      x: player.x, y: player.y,
      vx: Math.cos(angle)*(2+Math.random()*4),
      vy: Math.sin(angle)*(2+Math.random()*4),
      life:1, color: i%2===0 ? ch.color : ch.accent, r:3+Math.random()*4
    });
  }
}
function updateParticles() {
  for(var i=particles.length-1;i>=0;i--){
    var p=particles[i];
    p.x+=p.vx; p.y+=p.vy; p.vy+=0.15; p.life-=0.03;
    if(p.life<=0) particles.splice(i,1);
  }
}
function drawParticles() {
  for(var i=0;i<particles.length;i++){
    var p=particles[i];
    ctx.save(); ctx.globalAlpha=p.life;
    ctx.fillStyle=p.color;
    ctx.fillRect(p.x-p.r/2, p.y-p.r/2, p.r, p.r);
    ctx.restore();
  }
}

